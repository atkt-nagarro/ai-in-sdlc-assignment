+
+    [Fact]
+    public void Reject_WithWhitespaceReason_Throws()
+    {
+        var repository = new FakeInvoiceRepository();
+        repository.Add(Pending("INV-900"));
+        var service = new ApprovalService(repository);
+
+        Assert.Throws<ArgumentException>(() => service.Reject("INV-900", "nitin", "   "));
+    }
+
+    [Fact]
+    public void Approve_RecordsTheApproverAndTime()
+    {
+        var repository = new FakeInvoiceRepository();
+        repository.Add(Pending("INV-901"));
+        var service = new ApprovalService(repository);
+
+        var before = DateTime.UtcNow;
+        var result = service.Approve("INV-901", "nitin");
+
+        Assert.Equal("nitin", result.DecidedBy);
+        Assert.NotNull(result.DecidedAt);
+        Assert.InRange(result.DecidedAt!.Value, before, DateTime.UtcNow);
+    }
+
+    [Fact]
+    public void Approve_UnknownInvoice_Throws()
+    {
+        var service = new ApprovalService(new FakeInvoiceRepository());
+
+        Assert.Throws<KeyNotFoundException>(() => service.Approve("INV-nope", "nitin"));
+    }
