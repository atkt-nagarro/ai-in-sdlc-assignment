@@ -1,24 +1,44 @@
 using System.Net.Http.Json;
+using InvoiceApp.Domain;

 namespace InvoiceApp.Api.Clients;

 public class PayExClient : IPayExClient
 {
-    private readonly HttpClient _http;
     private readonly PayExOptions _options;
     private readonly ILogger<PayExClient> _logger;

-    public PayExClient(HttpClient http, PayExOptions options, ILogger<PayExClient> logger)
+    public PayExClient(PayExOptions options, ILogger<PayExClient> logger)
     {
-        _http = http;
         _options = options;
         _logger = logger;
     }

-    public async Task<PayExReceipt> SubmitAsync(Invoice invoice, CancellationToken ct)
+    public async Task<PayExReceipt> SubmitAsync(Invoice invoice, CancellationToken ct = default)
     {
-        var response = await _http.PostAsJsonAsync("/v2/payments", Map(invoice), ct);
+        var http = new HttpClient
+        {
+            BaseAddress = new Uri(_options.BaseUrl)
+        };
+        http.DefaultRequestHeaders.Add("X-Api-Key", _options.ApiKey);
+
+        var response = await http.PostAsJsonAsync("/v2/payments", Map(invoice), ct);
         response.EnsureSuccessStatusCode();
-        return await response.Content.ReadFromJsonAsync<PayExReceipt>(cancellationToken: ct)
+
+        var receipt = await response.Content.ReadFromJsonAsync<PayExReceipt>(cancellationToken: ct)
                ?? throw new InvalidOperationException("PayEx returned an empty receipt.");
+
+        _logger.LogInformation(
+            "Submitted invoice {InvoiceId} to PayEx, reference {Reference}",
+            invoice.Id, receipt.Reference);
+
+        return receipt;
     }

     private static PayExPayment Map(Invoice invoice) => new(
         invoice.Id,
         invoice.Amount,
         invoice.CustomerName);
 }

