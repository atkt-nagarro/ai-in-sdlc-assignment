diff --git a/src/InvoiceApp.Api/Clients/PayExClient.cs b/src/InvoiceApp.Api/Clients/PayExClient.cs
index 4a1c9e2..b73f0d8 100644
--- a/src/InvoiceApp.Api/Clients/PayExClient.cs
